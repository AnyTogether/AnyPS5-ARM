<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The microphone for voice in AnyTogether parties, under the hardened runtime. -->
    <key>com.apple.security.device.audio-input</key><true/>
    <!-- Apple events to Spotify and Music for the Now playing card (NowPlaying.swift), under the
         hardened runtime. macOS asks the user once for each of the two. -->
    <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
