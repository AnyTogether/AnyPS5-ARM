#version 450
#extension GL_GOOGLE_include_directive : require

// AMD FidelityFX Super Resolution 1 (RCAS), from 3rdparty/FidelityFX-FSR (MIT, Copyright (c) 2021
// Advanced Micro Devices, Inc.): EASU's output sharpened, `con` from FsrRcasCon.

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D source;
#ifdef WIDE
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D target;
#else
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;
#endif
layout(push_constant) uniform Constants {
    uvec4 con;
    uvec2 size;
} constants;

#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(source, clamp(p, ivec2(0), ivec2(constants.size) - 1), 0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx_fsr1.h"

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, constants.size))) return;
    AF1 r, g, b;
    FsrRcasF(r, g, b, pixel, constants.con);
    imageStore(target, ivec2(pixel), vec4(r, g, b, 1.0));
}
